{
  "name": "arca-studio-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "check:user-login": "node scripts/check-user-login.mjs",
    "dev:upsert-user": "node scripts/upsert-test-user.mjs",
    "user:set-status": "node scripts/set-user-status.mjs",
    "dev": "node local.js",
    "start": "node local.js",
    "load:smoke": "k6 run load-tests/mixed-workload.js -e PROFILE=smoke",
    "load:mixed": "k6 run load-tests/mixed-workload.js",
    "load:files": "k6 run load-tests/file-workload.js",
    "load:sse": "node load-tests/sse-probe.mjs",
    "lint:docs": "eslint src",
    "test": "node --test tests/*.test.js",
    "db:pull": "node scripts/prisma.mjs db pull",
    "db:migrate:dev": "node scripts/prisma.mjs migrate dev",
    "db:migrate:deploy": "node scripts/prisma.mjs migrate deploy",
    "db:migrate:status": "node scripts/prisma.mjs migrate status",
    "db:studio": "node scripts/prisma.mjs studio",
    "verify": "pnpm lint:docs && node scripts/prisma.mjs validate && pnpm test && pnpm --dir ../Frontend test && pnpm --dir ../Frontend build",
    "verify:db": "pnpm db:migrate:status"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1068.0",
    "@prisma/client": "^7.8.0",
    "@supabase/supabase-js": "^2.49.4",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "pg": "^8.21.0",
    "zod": "^4.4.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "bcrypt",
      "prisma"
    ]
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-plugin-jsdoc": "^64.3.4",
    "prisma": "^7.8.0"
  }
}
