PORT=3000
# Obligatorio: exactamente development, test o production. Otro valor impide arrancar.
NODE_ENV=development
ROUTE_AUTH_DISABLED_FOR_TESTS=false

# Credenciales locales opcionales para `pnpm dev:upsert-user`.
# Nunca configures estas variables en el frontend ni las confirmes en Git.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
TEST_USER_FIRST_NAME=Administrador
TEST_USER_LAST_NAME=Sistema
TEST_USER_PHONE=+584120000000
TEST_USER_ROLE=admin

CORS_ORIGINS=https://arcastudio.netlify.app,https://*.netlify.app
CORS_CREDENTIALS=true
CORS_ALLOW_NO_ORIGIN=true
CORS_ALLOWED_HEADERS=Accept,Authorization,Content-Type,Origin,Range,X-File-Name,X-Original-File-Name,X-Requested-With
CORS_EXPOSED_HEADERS=Accept-Ranges,Content-Disposition,Content-Length,Content-Range,Content-Type

DATABASE_URL=postgresql://user:password@localhost:5432/database
# Opcional: conexión para Prisma CLI y auditorías. Si se omite, usa DATABASE_URL.
# Supabase: usar el endpoint directo solo con IPv6 disponible (o add-on IPv4).
# En una red IPv4, DIRECT_URL puede usar el Session pooler verificado en puerto 5432.
# No usar el Transaction pooler (6543) para este propósito ni inventar su hostname.
DIRECT_URL=
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false
DATABASE_SSL_CA_CERT=
# Opcional. Por defecto: 3 en serverless (Vercel) y 10 en servidor persistente.
DATABASE_POOL_MAX=
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=10000
DATABASE_QUERY_TIMEOUT_MS=12000

# Structured per-request telemetry. Enable in staging during load tests.
REQUEST_METRICS_ENABLED=false
DATABASE_SLOW_QUERY_MS=500
AUTH_CACHE_TTL_MS=30000
AUTH_CACHE_MAX_ENTRIES=1000
RATE_LIMIT_MAX_KEYS=10000
COMMENT_RATE_LIMIT_MAX=30
COMMENT_RATE_LIMIT_WINDOW_MS=60000
PROJECT_REQUEST_RATE_LIMIT_MAX=10
PROJECT_REQUEST_RATE_LIMIT_WINDOW_MS=60000
UPLOAD_RATE_LIMIT_MAX=20
UPLOAD_RATE_LIMIT_WINDOW_MS=60000
SSE_MAX_CONNECTIONS_PER_USER=5
SSE_MAX_CONNECTIONS_PER_PROJECT=100
SHUTDOWN_TIMEOUT_MS=10000

AUTH_TOKEN_SECRET=replace-with-at-least-32-random-bytes
AUTH_TOKEN_EXPIRES_IN_SECONDS=43200
AUTH_TOKEN_CLOCK_TOLERANCE_MS=5000
AUTH_COOKIE_NAME=arca_session
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_SECURE=false
AUTH_LOGIN_RATE_LIMIT_MAX=5
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000

FRONTEND_URL=https://arcastudio.netlify.app
# En producción, configura el dominio de tu frontend real.
# FRONTEND_URL=https://arcastudio.netlify.app
PASSWORD_RESET_EXPIRES_IN_SECONDS=900
RESEND_API_KEY=replace-with-resend-api-key
MAIL_FROM=ARCA Studio <no-reply@yourdomain.com>
# Optional alternative sender variable used by some deployments
# RESEND_FROM_EMAIL=ARCA Studio <no-reply@yourdomain.com>

# Clave privada del backend para el autocompletado de ubicaciones.
GEOAPIFY_API_KEY=replace-with-geoapify-api-key

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-secret
SUPABASE_STORAGE_S3_ENDPOINT=https://your-project-ref.storage.supabase.co/storage/v1/s3
SUPABASE_STORAGE_S3_REGION=us-east-1
SUPABASE_STORAGE_S3_ACCESS_KEY_ID=replace-with-storage-access-key-id
SUPABASE_STORAGE_S3_SECRET_ACCESS_KEY=replace-with-storage-secret-access-key
SUPABASE_STORAGE_BUCKET=replace-with-bucket-name
FILE_UPLOAD_LIMIT=50mb
FILE_UPLOAD_MAX_BYTES=52428800
