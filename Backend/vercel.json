{
  "installCommand": "pnpm install",
  "buildCommand": null,
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "{assets/**,node_modules/@fontsource/inter/files/inter-latin-*-normal.woff}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ]
}
