  users_project_assignee        users    @relation("project_assignees_user", fields: [user_id], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_project_assignees_user")
  users_project_assigned_by     users    @relation("project_assignees_assigned_by", fields: [assigned_by], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_project_assignees_assigned_by")

  @@id([project_id, user_id])
