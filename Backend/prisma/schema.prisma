  title              String             @db.VarChar(255)
  description        String?            @db.VarChar(255)
  file_type          String             @db.VarChar(50)
  file_category      file_category      @default(document)
  current_version    Int?
  status             file_status        @default(active)
  created_at         DateTime           @default(now()) @db.Timestamptz(6)
  updated_at         DateTime           @default(now()) @db.Timestamptz(6)
  deleted_at         DateTime?          @db.Timestamptz(6)
  file_versions      file_versions?
  projects           projects?          @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_files_project")
  project_requests   project_requests?  @relation(fields: [project_request_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_files_project_request")
  users              users              @relation(fields: [uploaded_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_files_uploaded_by")
  project_comments   project_comments[]

  @@index([project_id, created_at(sort: Desc), id(sort: Desc)], map: "files_project_active_cursor_idx", where: raw("(deleted_at IS NULL)"))
  @@index([project_id], map: "idx_files_project_id", where: raw("((project_id IS NOT NULL) AND (deleted_at IS NULL))"))
  @@index([project_request_id], map: "idx_files_project_request_id", where: raw("((project_request_id IS NOT NULL) AND (deleted_at IS NULL))"))
