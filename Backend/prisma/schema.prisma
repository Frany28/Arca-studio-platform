/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model clients {
  id               BigInt             @id @default(autoincrement())
  name             String             @db.VarChar(150)
  company_name     String?            @db.VarChar(150)
  document_number  String?            @db.VarChar(150)
  email            String             @db.VarChar(150)
  phone            String?            @db.VarChar(30)
  address          String?            @db.VarChar(255)
  city             String?            @db.VarChar(100)
  country          String?            @db.VarChar(100)
  referral_source  String?            @db.VarChar(30)
  status           client_status      @default(active)
  notes            String?            @db.VarChar(255)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  updated_at       DateTime           @default(now()) @db.Timestamptz(6)
  deleted_at       DateTime?          @db.Timestamptz(6)
  project_requests project_requests[]
  projects         projects[]
  quote_versions   quote_versions[]
  users            users[]

  @@index([deleted_at], map: "idx_clients_deleted_at")
  @@index([document_number], map: "idx_clients_document_number")
  @@index([email], map: "idx_clients_email")
  @@index([status], map: "idx_clients_status")
}

