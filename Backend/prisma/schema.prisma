/// Private notes written by an administrator about a user.
/// Runtime access is always scoped by admin_user_id through parameterized SQL.
/// This model contains row level security and requires additional setup for migrations.
model admin_user_notes {
  id             BigInt   @id @default(autoincrement())
  admin_user_id  BigInt
  target_user_id BigInt
  content        String
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @db.Timestamptz(6)
  archived_at    DateTime? @db.Timestamptz(6)
  admin_user     users    @relation("admin_user_notes_admin", fields: [admin_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_admin_user_notes_admin")
  target_user    users    @relation("admin_user_notes_target", fields: [target_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_admin_user_notes_target")

  @@index([admin_user_id, target_user_id, created_at(sort: Desc), id(sort: Desc)], map: "admin_user_notes_owner_target_cursor_idx")
}
/// Revocable login sessions (B-3). The session JWT carries `sid` = id. No IP, user agent or token is stored.
/// This model contains row level security and requires additional setup for migrations.
model user_sessions {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        BigInt
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  expires_at     DateTime  @db.Timestamptz(6)
  revoked_at     DateTime? @db.Timestamptz(6)
  revoked_reason String?   @db.VarChar(40)
  users          users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_sessions_user")

  @@index([user_id], map: "user_sessions_active_user_idx", where: raw("(revoked_at IS NULL)"))
  @@index([expires_at], map: "user_sessions_expires_at_idx")
}

