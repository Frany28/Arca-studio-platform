/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model file_versions {
  id               BigInt             @id @default(autoincrement())
  file_id          BigInt             @unique(map: "uq_file_versions_current", where: raw("((is_current = true) AND (deleted_at IS NULL))"))
  uploaded_by      BigInt
  version_number   Int
  file_name        String             @db.VarChar(255)
  original_name    String             @db.VarChar(255)
  file_url         String             @db.VarChar(500)
  file_extension   String             @db.VarChar(50)
  file_size        BigInt
  change_note      String?            @db.VarChar(255)
  is_current       Boolean            @default(true)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  deleted_at       DateTime?          @db.Timestamptz(6)
  files            files              @relation(fields: [file_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_file_versions_file")
  users            users              @relation(fields: [uploaded_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_file_versions_uploaded_by")
  project_comments project_comments[]

  @@unique([file_id, version_number], map: "uq_file_versions_file_version")
  @@index([file_id], map: "idx_file_versions_file_id", where: raw("(deleted_at IS NULL)"))
}

