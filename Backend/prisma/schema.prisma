model audit_logs {
  id          BigInt   @id @default(autoincrement())
  user_id     BigInt?
  action      String   @db.VarChar(100)
  entity_type String   @db.VarChar(100)
  entity_id   BigInt
  description String?  @db.VarChar(255)
  new_values  Json?
  old_values  Json?
  ip_address  String?  @db.VarChar(255)
  user_agent  String?  @db.VarChar(255)
