  created_at               DateTime                              @default(now()) @db.Timestamptz(6)
  updated_at               DateTime                              @default(now()) @db.Timestamptz(6)
  project_requests         project_requests                     @relation(fields: [project_request_id], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "fk_project_request_reviews_request")
  users                    users                                @relation(fields: [reviewer_id], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "fk_project_request_reviews_reviewer")

  @@unique([project_request_id, reviewer_id], map: "uq_project_request_reviews_reviewer")
  @@index([reviewer_id, updated_at(sort: Desc)], map: "idx_project_request_reviews_reviewer")
}


