  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  updated_at     DateTime         @default(now()) @db.Timestamptz(6)
  users_created  users            @relation("quotes_created_by", fields: [created_by], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_quotes_created_by")
  users_updated  users            @relation("quotes_updated_by", fields: [updated_by], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_quotes_updated_by")
  quote_versions quote_versions[]

  @@index([created_at, id], map: "quotes_created_cursor_idx")
}

/// Historial inmutable de una cotización: cada guardado copia cliente, proyecto, observaciones y total.
/// Un trigger (quote_versions_immutable) solo permite pasar is_current de true a false e impide borrar.
/// This table contains check constraints and requires additional setup for migrations.
/// This model contains row level security and requires additional setup for migrations.
model quote_versions {
  id             BigInt        @id @default(autoincrement())
  quote_id       BigInt        @unique(map: "uq_quote_versions_current", where: raw("is_current"))
  version_number Int
  client_id      BigInt
  client_name    String        @db.VarChar(150)
  project_id     BigInt
  project_name   String        @db.VarChar(150)
  notes          String?
  services_total Decimal       @db.Decimal(14, 2)
  currency_code  String        @default("USD") @db.Char(3)
  is_current     Boolean       @default(true)
  created_by     BigInt
  created_at     DateTime      @default(now()) @db.Timestamptz(6)
  quotes         quotes        @relation(fields: [quote_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_quote_versions_quote")
  clients        clients       @relation(fields: [client_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_quote_versions_client")
  projects       projects      @relation(fields: [project_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_quote_versions_project")
  users          users         @relation("quote_versions_created_by", fields: [created_by], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_quote_versions_created_by")
  quote_items    quote_items[]

  @@unique([quote_id, version_number], map: "uq_quote_versions_quote_version")
  @@index([services_total, quote_id], map: "quote_versions_current_total_idx", where: raw("is_current"))
  @@index([client_id], map: "idx_quote_versions_client_id")
  @@index([project_id], map: "idx_quote_versions_project_id")
}

/// Conceptos inmutables de una versión: versión del servicio cotizada, cantidad, tarifa aplicada y subtotal.
/// Un trigger (quote_items_immutable) impide modificarlos o borrarlos; el CHECK replica el redondeo del motor.
/// This table contains check constraints and requires additional setup for migrations.
/// This model contains row level security and requires additional setup for migrations.
model quote_items {
  id                 BigInt           @id @default(autoincrement())
  quote_version_id   BigInt
  line_number        Int
  service_id         BigInt
  service_version_id BigInt
  /// Unidad cotizada: copia de la versión del servicio (FK compuesta con service_version_id).
  service_version_unit_option_id BigInt
  quantity           Decimal          @db.Decimal(12, 3)
  unit_rate          Decimal          @db.Decimal(14, 2)
  reference_rate     Decimal          @db.Decimal(14, 2)
  subtotal           Decimal          @db.Decimal(14, 2)
  created_at         DateTime         @default(now()) @db.Timestamptz(6)
  quote_versions     quote_versions   @relation(fields: [quote_version_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_quote_items_quote_version")
  services           services         @relation(fields: [service_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_quote_items_service")
  service_versions   service_versions @relation(fields: [service_version_id, service_id], references: [id, service_id], onDelete: Restrict, onUpdate: NoAction, map: "fk_quote_items_service_version")
  service_version_unit_options service_version_unit_options @relation(fields: [service_version_unit_option_id, service_version_id], references: [id, service_version_id], onDelete: Restrict, onUpdate: NoAction, map: "fk_quote_items_service_version_unit_option")

  @@unique([quote_version_id, line_number], map: "uq_quote_items_version_line")
  @@unique([quote_version_id, service_id], map: "uq_quote_items_version_service")
  @@index([service_id], map: "idx_quote_items_service_id")
  @@index([service_version_id], map: "idx_quote_items_service_version_id")
  @@index([service_version_unit_option_id], map: "idx_quote_items_service_version_unit_option_id")
}

/// Unidades vigentes de cada servicio (1 a 10, posiciones 1..n). La posición 1 es la principal y
/// coincide con services.measurement_unit_id / unit_denomination_id (trigger diferido
/// service_unit_options_consistent). reference_rate NULL = tarifa pendiente de validación
/// comercial (no se cotiza); con una sola unidad, su tarifa es la del servicio.
/// uq_service_unit_options_unit usa NULLS NOT DISTINCT y se define en la migración.
/// This table contains check constraints and requires additional setup for migrations.
/// This model contains row level security and requires additional setup for migrations.
model service_unit_options {
  id                   BigInt            @id @default(autoincrement())
  service_id           BigInt
  position             Int               @db.SmallInt
  measurement_unit_id  BigInt
  unit_denomination_id BigInt?
  /// Texto comercial que sustituye a la etiqueta compuesta («Global por Proyecto»).
  presentation_label   String?           @db.VarChar(80)
  reference_rate       Decimal?          @db.Decimal(14, 2)
  created_at           DateTime          @default(now()) @db.Timestamptz(6)
  updated_at           DateTime          @default(now()) @db.Timestamptz(6)
  services             services          @relation(fields: [service_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_service_unit_options_service")
  measurement_units    measurement_units @relation(fields: [measurement_unit_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_service_unit_options_measurement_unit")
  measurement_unit_denominations measurement_unit_denominations? @relation(fields: [unit_denomination_id, measurement_unit_id], references: [id, measurement_unit_id], onDelete: Restrict, onUpdate: NoAction, map: "fk_service_unit_options_unit_denomination")

  @@unique([service_id, position], map: "uq_service_unit_options_position")
  @@index([measurement_unit_id], map: "idx_service_unit_options_measurement_unit_id")
  @@index([unit_denomination_id], map: "idx_service_unit_options_unit_denomination_id", where: raw("(unit_denomination_id IS NOT NULL)"))
}

/// Copia inmutable de las unidades de una versión de servicio (trigger
/// service_version_unit_options_immutable: sin UPDATE ni DELETE). Conserva unidad, denominación,
/// etiqueta comercial y tarifa (NULL = pendiente) vigentes al versionar.
/// This table contains check constraints and requires additional setup for migrations.
/// This model contains row level security and requires additional setup for migrations.
model service_version_unit_options {
  id                   BigInt            @id @default(autoincrement())
  service_version_id   BigInt
  position             Int               @db.SmallInt
  measurement_unit_id  BigInt
  unit_code            String            @db.VarChar(30)
  unit_name            String            @db.VarChar(80)
  unit_symbol          String            @db.VarChar(20)
  unit_allows_decimals Boolean
  unit_denomination_id BigInt?
  unit_denomination    String?           @db.VarChar(80)
  presentation_label   String?           @db.VarChar(80)
  reference_rate       Decimal?          @db.Decimal(14, 2)
  created_at           DateTime          @default(now()) @db.Timestamptz(6)
  service_versions     service_versions  @relation(fields: [service_version_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_service_version_unit_options_version")
  measurement_units    measurement_units @relation(fields: [measurement_unit_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_service_version_unit_options_measurement_unit")
  measurement_unit_denominations measurement_unit_denominations? @relation(fields: [unit_denomination_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_service_version_unit_options_unit_denomination")
  quote_items          quote_items[]

  @@unique([service_version_id, position], map: "uq_service_version_unit_options_position")
  /// Destino de la FK compuesta de quote_items: la unidad cotizada pertenece a la versión indicada.
  @@unique([id, service_version_id], map: "uq_service_version_unit_options_id_version")
  @@index([measurement_unit_id], map: "idx_service_version_unit_options_measurement_unit_id")
  @@index([unit_denomination_id], map: "idx_service_version_unit_options_unit_denomination_id", where: raw("(unit_denomination_id IS NOT NULL)"))
}

