/// Technical recommendations recorded by assigned reviewers.
model project_request_reviews {
  id                       BigInt                                @id @default(autoincrement())
  project_request_id       BigInt
  reviewer_id              BigInt
  recommendation           project_request_review_recommendation
  /// Nullable para conservar el significado de revisiones históricas sin decisión de reunión.
